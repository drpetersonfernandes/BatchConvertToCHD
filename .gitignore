# ECM decoding is built in, so this third-party binary is not a dependency. It is only useful for
# regenerating the ECM test fixture, and must not be committed if someone drops a copy in.
[Bb]atch[Cc]onvertTo[Cc][Hh][Dd]/unecm.exe

